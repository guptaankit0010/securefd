          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const enableBearer = pm.environment.get(\"ENABLE_BEARER\");",
                  "",
                  "if (enableBearer === \"true\") {",
                  "    if (res.accessToken) {",
                  "        pm.collectionVariables.set(\"accessToken\", res.accessToken);",
                  "    }",
                  "} else {",
                  "    pm.collectionVariables.unset(\"accessToken\");",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
